"""Prepare an intentional candidate revision; MUST NOT certify proof success.

Preserves every historical theorem header and records source/API bindings.
The authoritative compiler/axiom gate is run_retry.py; see MASTER_PLAN.md.
Only simple historical theorem declaration syntax is supported, fail closed.
"""
import hashlib
import json
from pathlib import Path
import re
from run_retry import named_theorems, strip_comments

HERE = Path(__file__).resolve().parent
OLD = HERE.parent / 'miner-full-rebuild'


def sha(path):
    return hashlib.sha256(path.read_bytes()).hexdigest()


def headers(text):
    starts = list(re.finditer(r'(?m)^(?:theorem|lemma)\s+(\w+)', text))
    result = {}
    for index, start in enumerate(starts):
        end = starts[index + 1].start() if index + 1 < len(starts) else len(text)
        chunk = text[start.start():end]
        body = re.search(r' :=(?: by\b|\n| fun\b)', chunk)
        if body is None:
            raise RuntimeError('Unsupported theorem header: ' + start[1])
        if start[1] in result:
            raise RuntimeError('Duplicate theorem: ' + start[1])
        result[start[1]] = chunk[:body.start()]
    # Independent namespace-aware inventory catches unsupported attributed or
    # qualified declaration forms rather than silently omitting their headers.
    if sorted(result) != sorted(n.rsplit('.', 1)[-1] for n in named_theorems(text)):
        raise RuntimeError('Header parser omitted a named theorem')
    return result


def main():
    historical = json.loads((OLD / 'report.json').read_text())
    sources = historical['sources']
    preserved = {}
    import_only = {}
    for relative, digest in sources.items():
        if sha(OLD / 'sources' / relative) != digest:
            raise RuntimeError('Historical source changed: ' + relative)
        if Path(relative).name not in {'RodCircles.lean', 'RodScaling.lean', 'TowerCollapse.lean'}:
            continue
        old = headers((OLD / 'sources' / relative).read_text())
        new = headers((HERE / 'sources' / relative).read_text())
        for name, header in old.items():
            if new.get(name) != header:
                raise RuntimeError('Historical theorem header changed: ' + relative + ':' + name)
        preserved[relative] = {
            'original_theorems': sorted(old),
            'header_sha256': {k: hashlib.sha256(v.encode()).hexdigest() for k, v in old.items()},
            'added_helpers': sorted(set(new) - set(old)),
        }
    for name in ['PowSqrtPrime', 'OrderSplit']:
        relative = 'LatticeCalc/Verified/' + name + '.lean'
        def body(path):
            return ' '.join(re.sub(r'(?m)^public import [\w.]+\s*$', '',
                                  strip_comments(path.read_text())).split())
        old_body = body(OLD / 'sources' / relative)
        if old_body != body(HERE / 'sources' / relative):
            raise RuntimeError('Dependency change exceeds imports/comments: ' + relative)
        import_only[relative] = hashlib.sha256(old_body.encode()).hexdigest()
    api = json.loads((HERE / 'api-support.json').read_text())
    rows = api['scalar_checks']
    required = ['11*12', '19*18', '11*19*71*97*109', '12*20*72*96*108', '12*18*72*96*108']
    if [r['expression'] for r in rows] != required:
        raise RuntimeError('Unexpected API scalar inventory')
    lean = ['/-! MUST certify the recorded API scalar values only; see ../../MASTER_PLAN.md.',
            'Generated by prepare_manifest.py; API metadata and universal algorithms are outside this scope. -/',
            'namespace ApiSupportNumbers']
    for i, row in enumerate(rows):
        response = row['response']
        value = response['evaluation']['value']
        if row['http_status'] != 200 or response.get('ok') is not True or response['evaluation'].get('ok') is not True:
            raise RuntimeError('Failed API response')
        if type(value) is not int or value != row['actual'] or response['expression'] != row['expression']:
            raise RuntimeError('API result does not match recorded provenance')
        # The grammar is deliberately just integer products. No API expression is
        # executed as source code; each accepted token must be a decimal integer.
        parts = row['expression'].split('*')
        if not all(re.fullmatch(r'[0-9]+', p) for p in parts):
            raise RuntimeError('Unsupported API grammar')
        expr = ' * '.join(parts)
        lean.append(f'theorem returned_{i + 1} : ({expr} : Nat) = {value} := by decide')
    lean.append('end ApiSupportNumbers\n')
    rel = 'RequestProject/ApiSupportNumbers.lean'
    (HERE / 'sources' / rel).write_text('\n'.join(lean))
    manifest = {
        'status': 'candidate_pending_fresh_gate',
        'historical_report_sha256': sha(OLD / 'report.json'),
        'historical_sources': sources,
        'sources': {r: sha(HERE / 'sources' / r) for r in list(sources) + [rel]},
        'historical_targets': historical['targets'],
        'dependency_manifest_sha256': historical['dependency_manifest_sha256'],
        'preserved_theorem_headers': preserved,
        'dependency_mathematical_bodies_unchanged': import_only,
        'api_support_sha256': sha(HERE / 'api-support.json'),
        'scope': 'Exact historical theorem headers preserved; formal proof and assumption acceptance pending run_retry.py.',
    }
    (HERE / 'source-manifest.json').write_text(json.dumps(manifest, indent=2) + '\n')
    print(json.dumps({'preserved_theorems': sum(len(p['original_theorems']) for p in preserved.values()),
                      'api_scalar_roots': len(rows), 'status': manifest['status']}))


if __name__ == '__main__':
    main()
